# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Secrets and environment variables
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Local databases and market data
*.db
*.sqlite
*.sqlite3
*.duckdb
data/raw/*
data/processed/*
data/snapshots/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/snapshots/.gitkeep
# Version the small, auditable Nifty 500 source snapshots only.
!data/raw/universe/
!data/raw/universe/nifty500_current.csv
!data/raw/universe/nifty500_source_*.csv
!data/snapshots/universe/
!data/snapshots/universe/nifty500_*.csv
!data/snapshots/universe/nifty500_*.json

# Large files
*.parquet
*.feather
*.pkl
*.pickle
*.zip

# Jupyter
.ipynb_checkpoints/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
logs/

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Version the compact official NSE current individual-stock F&O underlying snapshot.
!data/raw/fno_underlyings/
!data/raw/fno_underlyings/*.json
!data/raw/fno_underlyings/*.csv
!data/snapshots/fno_underlyings/
!data/snapshots/fno_underlyings/*.csv
!data/snapshots/fno_underlyings/*.json
